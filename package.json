{
  "name": "echovale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, keyboard-first RSS reader for a private household.",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "node scripts/wait-for-server.mjs && vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist/server --packages=external --sourcemap",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "10.1.0",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3": "12.11.1",
    "fastify": "5.10.0",
    "feedsmith": "2.9.5",
    "jsdom": "29.1.1",
    "lucide-react": "1.24.0",
    "parse-srcset": "1.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "2.17.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/jsdom": "28.0.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.4",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
