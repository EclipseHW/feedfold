{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "feedfold-demo",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./dist/demo",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "feedfold.com",
      "custom_domain": true
    }
  ]
}
